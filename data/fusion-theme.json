    "backgroundPanel": {
      "dark": "#0a101d",
      "light": "#f5f7fa"
    },
    "backgroundElement": {
      "dark": "#0d1524",
      "light": "#e8ecf1"
    },
    "border": {
      "dark": "#16233a",
      "light": "#d3dae3"
