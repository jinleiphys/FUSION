{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "#05080f",
    "backgroundAlt": "#0a101d",
    "backgroundPanel": "#0d1524",
    "foreground": "#e9eef8",
    "foregroundMuted": "#8fa0b8",
    "yellow": "#ffd166",
    "yellowBright": "#ffe1a0",
    "orange": "#ffa028",
    "orangeBright": "#ffbe6b",
    "mint": "#5fe0c8",
    "mintBright": "#9beedd",
    "blue": "#52b7ff",
    "blueBright": "#8ed0ff",
    "pink": "#ff7a93",
    "pinkBright": "#ffa7b8",
    "green": "#6fd08c",
    "greenBright": "#a3e4b5",
    "purple": "#a98cff",
    "purpleBright": "#c6b3ff",
    "red": "#ff6b6b",
    "redBright": "#ff9c9c"
  },
  "theme": {
    "primary": {
      "dark": "blue",
      "light": "#52b7ff"
    },
    "secondary": {
      "dark": "orange",
      "light": "#ffa028"
    },
    "accent": {
      "dark": "orange",
      "light": "#ffa028"
    },
    "error": {
      "dark": "red",
      "light": "#e91e63"
    },
    "warning": {
      "dark": "yellow",
      "light": "#ff9800"
    },
    "success": {
      "dark": "green",
      "light": "#4caf50"
    },
    "info": {
      "dark": "orange",
      "light": "#ff5722"
    },
    "text": {
      "dark": "foreground",
      "light": "#193549"
    },
