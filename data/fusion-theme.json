      "light": "#5c6b7d"
    },
    "syntaxKeyword": {
      "dark": "orange",
      "light": "#ff5722"
    },
    "syntaxFunction": {
      "dark": "yellow",
      "light": "#ff9800"
    },
    "syntaxVariable": {
      "dark": "foreground",
      "light": "#193549"
    },
    "syntaxString": {
      "dark": "green",
      "light": "#4caf50"
    },
    "syntaxNumber": {
      "dark": "pink",
      "light": "#e91e63"
    },
    "syntaxType": {
      "dark": "mint",
      "light": "#00acc1"
    },
    "syntaxOperator": {
      "dark": "orange",
      "light": "#ff5722"
    },
    "syntaxPunctuation": {
      "dark": "foreground",
      "light": "#193549"
    }
