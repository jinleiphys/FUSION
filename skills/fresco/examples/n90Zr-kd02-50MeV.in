n + 90Zr elastic, KD02 at 50 MeV (FUSION fresco skill, omp.py-generated potential)
NAMELIST
 &FRESCO hcm=0.025 rmatch=60
	 jtmin=0.0 jtmax=80 absend=-1
	 thmin=0.00 thmax=180.00 thinc=1.00
	 chans=1 smats=2 xstabl=1
	 elab=50.0 /

 &PARTITION namep='n' massp=1.0 zp=0
 	    namet='90Zr' masst=90.0 zt=40 qval=0.000 nex=1 /
 &STATES jp=0.5 bandp=1 ep=0.0000 cpot=1 jt=0.0 bandt=1 et=0.0000 /
 &partition /

! KD02 global OMP, n + 90Zr, E_lab = 50.0 MeV
! target Z=40 A=90;  ap=0 forces R = r0*At^(1/3), the convention both KD02 and this script use.
! neutron projectile: rc is unused but the type=0 line must still be present.
 &POT kp=1 type=0 ap=0.000 at=90.000 rc=1.200000 /
 &POT kp=1 type=1 p1=35.274524 p2=1.213437 p3=0.664417 p4=4.760451 p5=1.213437 p6=0.664417 /
 &POT kp=1 type=2 p4=3.793594 p5=1.271370 p6=0.529696 /
 &POT kp=1 type=3 p1=4.892278 p2=1.041026 p3=0.590000 p4=-0.369964 p5=1.041026 p6=0.590000 /
 &pot /
 &overlap /
 &coupling /
